<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Calculadora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="BotonCalculadora" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_gravity">fill</item>

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_columnWeight">1</item>

        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>


    <style name="BotonCalculadora.Numero">
        <item name="backgroundTint">#333333</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>


    <style name="BotonCalculadora.Operador">
        <item name="backgroundTint">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="BotonCalculadora.Accion">
        <item name="backgroundTint">#A5A5A5</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="BotonCalculadora.Acento">
        <item name="backgroundTint">#4CAF50</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>